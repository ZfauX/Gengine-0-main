# deploy/systemd/gengine-db.env
# Переменные PostgreSQL для контейнера gengine-db (POSTGRES_*, не DB_*).
# Скопируйте в ~/.config/gengine/gengine-db.env и задайте свои значения.
# ВАЖНО (L4, PASS-16): НЕ используйте этот файл как есть в production —
# пароль ниже — заведомо невалидная заглушка, PostgreSQL откажет в старте
# без его замены (защита от копипасты слабого 'change-me').
POSTGRES_USER=gengine
POSTGRES_PASSWORD=__SET_A_STRONG_PASSWORD__
POSTGRES_DB=gengine
