# ============================================
# Gengine Configuration Template
# Copy to .env and fill in all required values
# ============================================

# --- Server ---
PORT=8080
GIN_MODE=release               # release|debug|test
BASE_URL=http://localhost:8080 # used for email links and OAuth redirects
LOG_MAX_BACKUPS=10            # max number of log backups to keep

# --- Database (REQUIRED) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=egengine
# DB_PASSWORD – REQUIRED: set a strong password
DB_PASSWORD=
DB_NAME=gengine
DB_SSLMODE=require             # disable|require|verify-full

# --- Database Connection Pool (optional, defaults shown) ---
# DB_MAX_OPEN_CONNS=50        # max open connections (default: 50)
# DB_MAX_IDLE_CONNS=25        # max idle connections (default: 25)
# DB_CONN_MAX_LIFETIME=5m     # max connection lifetime (e.g. 5m, 1h)

# --- Redis (optional, Valkey-compatible) ---
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=

# ============================================
# !! SECURITY – CHANGE IMMEDIATELY !!
# ============================================

# JWT secret (REQUIRED) – generate with: openssl rand -base64 32
# JWT_SECRET – REQUIRED: set a strong random string
JWT_SECRET=

# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=168h

# Session secret (REQUIRED) – similarly strong and unique
# SESSION_SECRET – REQUIRED: set a strong random string
SESSION_SECRET=

# Admin credentials (REQUIRED) – email and strong password (min 12 chars)
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD – REQUIRED: set a strong password (min 12 chars)
ADMIN_PASSWORD=

# ============================================
# External Services (enable by setting *_ENABLED=true)
# ============================================

# VK OAuth — вход через VK ID
VK_ENABLED=false
# VK_CLIENT_ID – required if enabled
VK_CLIENT_ID=
# VK_CLIENT_SECRET – required if enabled
VK_CLIENT_SECRET=

# Yandex OAuth
YANDEX_ENABLED=false
YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET – required if enabled
YANDEX_CLIENT_SECRET=

# SMTP (for email notifications and verification)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SMTP_PASSWORD – required if enabled
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# reCAPTCHA (for form protection)
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY – required if enabled
RECAPTCHA_SECRET_KEY=

# TLS (optional – leave empty for HTTP)
TLS_CERT_FILE=
TLS_KEY_FILE=

# Sentry (optional – error tracking)
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACING_RATE=0.1

# VAPID keys for Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# WebAuthn (passkeys) — если не заданы, RPID из BaseURL, origins из BaseURL + localhost fallback
WEBAUTHN_RPID=                                      # relying party ID (например: localhost, example.com)
WEBAUTHN_ORIGINS=                                   # origins через запятую (например: http://localhost:8080,http://127.0.0.1:8080)

# Logging
LOG_LEVEL=info                                 # debug, info, warn, error
LOG_FORMAT=console                             # console or json
LOG_FILE_PATH=                                 # empty = stderr only
LOG_MAX_SIZE=100                               # MB per log file
LOG_MAX_AGE=30                                 # days to keep logs
LOG_COMPRESS=false                             # compress rotated logs

# Server paths
STATIC_DIR=static                              # static files directory
UPLOADS_DIR=uploads                            # uploads directory
MAX_UPLOAD_SIZE=10485760                       # max upload size (bytes, default 10MB)
MAX_BODY_SIZE=52428800                         # max request body (bytes, default 50MB)
CORS_ORIGINS=                                  # comma-separated allowed origins
TRUSTED_PROXIES=                               # comma-separated trusted proxy CIDRs
STRICT_CONFIG=false                            # strict config validation mode

# Database connection pool
DB_CONN_MAX_IDLE_TIME=10m                      # max idle connection time

# Rate limiting
RATE_LIMIT_WINDOW=1m                           # rate limiter window duration
RATE_LIMIT_GLOBAL=100                          # global requests per window
RATE_LIMIT_LOGIN=5                             # login attempts per window
RATE_LIMIT_REGISTRATION=3                      # registrations per window
RATE_LIMIT_CODE_SUBMISSION=10                  # code submissions per window
RATE_LIMIT_SSE=10                              # SSE connections per window
RATE_LIMIT_API=60                              # API requests per window

# Valkey connection pool
VALKEY_POOL_SIZE=10                            # max connections in pool
VALKEY_MIN_IDLE_CONNS=3                        # min idle connections
VALKEY_MAX_RETRIES=3                           # max retry attempts

# WebSocket limits
WS_MAX_TOTAL_CONNS=1000                        # max total WebSocket connections
WS_MAX_CONNS_PER_IP=50                         # max connections per IP